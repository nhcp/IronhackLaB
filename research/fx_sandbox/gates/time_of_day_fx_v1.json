{
  "name": "time_of_day_fx_v1",
  "family": "time_of_day",
  "symbols": [
    "EURUSD",
    "XAUUSD",
    "SPX500",
    "GER40"
  ],
  "timeframe": "1h",
  "is_months": 18,
  "oos_months": 6,
  "step_months": 6,
  "min_trades_is": 30,
  "pass_mode": "any_symbol",
  "param_grid": {
    "lookback_days": [
      30,
      60,
      90
    ],
    "entry_thresh": [
      0.0003,
      0.0005,
      0.001
    ]
  },
  "conditions": [
    {
      "metric": "total_return_h1",
      "operator": ">",
      "threshold": 0
    },
    {
      "metric": "total_return_h2",
      "operator": ">",
      "threshold": 0
    },
    {
      "metric": "sharpe",
      "operator": ">=",
      "threshold": 0.5
    },
    {
      "metric": "trades_per_month",
      "operator": ">=",
      "threshold": 30
    },
    {
      "metric": "trades_per_month",
      "operator": "<=",
      "threshold": 500
    }
  ],
  "cost_model": "fx_data.COSTS gated column + 0.01%/night held; data pins in data/SHA256SUMS"
}
